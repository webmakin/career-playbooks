# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Node (mdBook doesn't need it but rule it out)
node_modules/

# mdBook build output (we build into ./site/)
/site/

# Old book/ tree from previous config — no longer used
/book/

# mdBook build artifacts accidentally committed before .gitignore was tightened
# (we now build into ./site/ — anything that LOOKS like a build output should
# never be in src/, which is for source markdown only)
/src/**/*.html

# Session / test artifacts
/_shared/tools/test.txt

# Local-only
.env.local
*.local